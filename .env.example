# Copy to .env. Everything works without these.
# .env is gitignored. Do not commit passwords or tokens.
PYTHONPATH=src

# Snowflake login for Cortex Code (`cortex -c hack`).
# SNOWFLAKE_PASSWORD is your Snowsight password, or a programmatic access token
# from Snowsight → Settings → Authentication.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# Optional: route questions through Claude (still validated by the semantic layer)
# ANTHROPIC_API_KEY=
# THROUGHLINE_MODEL=claude-sonnet-5-5
